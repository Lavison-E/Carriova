# =====================================================================
# CARRIOVA - environment variables (template, safe to commit)
# =====================================================================
# Local:      copy to .env (git-ignored) and fill in the values.
# Production: set the same variables in your hosting provider settings.
#
# - Optional integrations stay disabled when their configuration is absent.
#   Accounts, private documents and the CRM require PostgreSQL.
# - Only NEXT_PUBLIC_* values reach the browser: never put a secret there.
# - Rebuild after any change (NEXT_PUBLIC_* values and static pages are
#   generated at build time). Startup logs list active integrations
#   ("[env] integrations - ...") and configuration errors.
# =====================================================================

# --- Core -------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string. SECRET.
# Production: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# [OPTIONAL] Direct Neon connection for schema migrations; DATABASE_URL may
# remain pooled for the application. If omitted, migrations use DATABASE_URL.
DATABASE_URL_UNPOOLED=

# [REQUIRED IN PRODUCTION] Canonical public origin, https, no trailing slash.
# Drives canonical URLs, Open Graph, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.carriovaci.com

# [RECOMMENDED] Public contact mailbox - a real, monitored inbox.
# Shown on /contact, /legal/confidentialite, the footer and Organization schema.
CONTACT_EMAIL=contact@carriovaci.com
# [OPTIONAL] Monitored mailbox for customer questions and notification replies.
# Defaults to CONTACT_EMAIL when empty; use a real inbox, not the no-reply sender.
SUPPORT_EMAIL=

# --- Email notifications - Resend (https://resend.com) ------------------
# Sends an alert to the team for every new lead, and an acknowledgement
# to the person (newsletter acknowledgement only with marketing consent).
# API key "re_...". SECRET.
RESEND_API_KEY=
# Sender on a domain verified in Resend (SPF/DKIM DNS records).
# Legacy sender for existing public-form notifications.
EMAIL_FROM=contact@carriovaci.com
# Transactional sender for account, password-reset and workspace emails.
# Defaults in code to CARRIOVA <noreply@carriovaci.com> when empty.
EMAIL_TRANSACTIONAL_FROM=CARRIOVA <noreply@carriovaci.com>
# Internal inbox(es) receiving new-lead alerts, comma-separated.
LEAD_NOTIFICATION_EMAIL=contact@carriovaci.com

# --- WhatsApp -----------------------------------------------------------
# Public business number for the "Écrire sur WhatsApp" click-to-chat link
# (contact page + footer). International format, digits only.
# Example: 2250700000000
NEXT_PUBLIC_WHATSAPP_NUMBER=2250502904438
# WhatsApp Cloud API (Meta): confirmation message sent to people who gave
# an international number (+225...) AND agreed to be contacted.
# Requires a verified Meta Business account and an APPROVED message
# template whose body contains exactly one variable {{1}} = first name.
# Permanent System User access token. SECRET.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# --- CRM webhook (HubSpot workflow, Zapier, Make, n8n, custom CRM...) ----
# POST JSON for lead.created, coaching.requested, account.created and
# newsletter.subscribed, including the lifecycle stage
# (PROSPECT / LEAD / ACCOUNT_CREATED). HTTPS required in production.
CRM_WEBHOOK_URL=
# HMAC-SHA256 signing secret, 16+ characters. SECRET. Verify on receipt:
#   X-Carriova-Signature == "sha256=" + hex(HMAC_SHA256(secret, timestamp + "." + rawBody))
#   where timestamp = X-Carriova-Timestamp header (reject old timestamps).
CRM_WEBHOOK_SECRET=

# --- Admin lead export ----------------------------------------------------
# Enables GET /api/admin/leads (CSV, max 5000 rows via ?limit=) with the
# header "Authorization: Bearer <token>". 32+ random characters. SECRET.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Analytics & search engines -----------------------------------------
# Plausible Analytics (cookieless): the site domain registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Search Console "HTML tag" method: the content value only.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the msvalidate.01 content value only.
BING_SITE_VERIFICATION=

# --- Advanced (optional) ------------------------------------------------
# Override provider endpoints (proxy, regional endpoint, local tests).
# RESEND_BASE_URL=https://api.resend.com
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_API_VERSION=v23.0

# ---------------------------------------------------------------------
# Customer and staff authentication use PostgreSQL-backed sessions.
# Password recovery and account invitations use the Resend settings above.
# Payments and error-monitoring services are not integrated; only add their
# variables together with the corresponding implementation.
# ---------------------------------------------------------------------

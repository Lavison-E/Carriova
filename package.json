{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.mjs",
    "test": "node --test tests/*.test.cjs",
    "db:crm": "node scripts/migrate-crm.mjs",
    "crm:user": "node scripts/staff-user.mjs",
    "crm:invite": "node scripts/staff-invite.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.29",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
